+/* MennoTeX: when kpathsea's on-demand resolver could not install a package
+   that has a missing file (declined, or the install failed), it queues a
+   warning. Print it to the terminal and the log, where editors look; mtx's
+   own message goes to stderr only. Called by kpathsea when it queues one,
+   and after opening a file. Only while TeX prints to the terminal or the log
+   (selector term_only, log_only or term_and_log); otherwise later. */
+static void
+mtx_print_problems (void)
+{
+    string msg;
+    const char *c;
+    while (selector >= 17 && selector <= 19
+           && (msg = kpathsea_ondemand_problem ()) != NULL) {
+        if (termoffset > 0 || fileoffset > 0)
+            println ();
+        for (c = msg; *c; c++)
+            print ((unsigned char) *c);
+        println ();
+        free (msg);
+    }
+}
